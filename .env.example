APP_NAME="Personal AI Development Environment"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=replace-this-for-local-use
TERMINAL_ENABLED=false

# Optional LLM provider credentials. Keep real values only in your ignored .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=

# LLM Provider Configuration
# Get API keys from your provider's dashboard
# OpenAI: https://platform.openai.com/api-keys
# Ollama: Run local models (no API key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Use a local Ollama instance for free models
# OLLAMA_BASE_URL=http://localhost:11434/api
